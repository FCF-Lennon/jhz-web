---
import { SITE_INFO, MAIN_NAV, QUICK_ACTIONS } from "../data/site";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-white shadow-sm border-b border-slate-200/80">
  <!-- Barra superior institucional (solo escritorio para evitar saturación móvil) -->
  <div class="hidden lg:block bg-jhz-navy text-white text-xs">
    <div class="max-w-7xl mx-auto px-6 h-9 flex items-center justify-between">
      <div class="flex items-center gap-5 text-slate-200">
        <a href={`tel:${SITE_INFO.phone.replace(/\s+/g, '')}`} class="hover:text-jhz-gold transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-jhz-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {SITE_INFO.phone}
        </a>
        <a href={`mailto:${SITE_INFO.email}`} class="hover:text-jhz-gold transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-jhz-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {SITE_INFO.email}
        </a>
      </div>

      <div class="flex items-center gap-4">
        <span class="text-slate-300">Síguenos:</span>
        <div class="flex items-center gap-3">
          <a href={SITE_INFO.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram Colegio JHZ" class="hover:text-jhz-gold transition-colors">
            Instagram
          </a>
          <span class="text-slate-600">•</span>
          <a href={SITE_INFO.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook Colegio JHZ" class="hover:text-jhz-gold transition-colors">
            Facebook
          </a>
          <span class="text-slate-600">•</span>
          <a href={SITE_INFO.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube Colegio JHZ" class="hover:text-jhz-gold transition-colors">
            YouTube
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra principal -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo + Nombre -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <img
          src={SITE_INFO.logoUrl}
          alt={`Escudo ${SITE_INFO.name}`}
          width="52"
          height="52"
          class="w-12 h-12 sm:w-14 sm:h-14 object-contain transition-transform group-hover:scale-105"
        />
        <div class="leading-tight">
          <span class="block text-xs font-semibold uppercase tracking-wider text-jhz-blue">
            Centro Educacional Bicentenario
          </span>
          <span class="block text-base sm:text-lg font-bold text-jhz-navy">
            Jorge Huneeus Zegers
          </span>
        </div>
      </a>

      <!-- Navegación Escritorio -->
      <nav aria-label="Navegación principal" class="hidden xl:flex items-center gap-1">
        {MAIN_NAV.map((item) => {
          const isActive = currentPath === item.href;
          return item.children ? (
            <div class="relative group">
              <button
                type="button"
                class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-jhz-navy hover:bg-slate-100/80 transition-colors flex items-center gap-1 cursor-pointer"
                aria-expanded="false"
              >
                {item.label}
                <svg class="w-4 h-4 text-slate-400 group-hover:text-jhz-navy transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Dropdown -->
              <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-2 w-60 z-50">
                <ul class="bg-white rounded-xl shadow-xl border border-slate-200/80 py-2">
                  {item.children.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        target={sub.external ? '_blank' : undefined}
                        rel={sub.external ? 'noopener noreferrer' : undefined}
                        class="flex items-center justify-between px-4 py-2 text-sm text-slate-700 hover:bg-jhz-surface hover:text-jhz-navy font-medium transition-colors"
                      >
                        <span>{sub.label}</span>
                        {sub.external && (
                          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                isActive
                  ? 'bg-jhz-navy/10 text-jhz-navy font-semibold'
                  : 'text-slate-700 hover:text-jhz-navy hover:bg-slate-100/80',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Botones de Acción Rápida (Escritorio) -->
      <div class="hidden xl:flex items-center gap-2.5">
        {QUICK_ACTIONS.map((action) => (
          <a
            href={action.href}
            target={action.external ? '_blank' : undefined}
            rel={action.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-semibold transition-all',
              action.highlight
                ? 'bg-jhz-gold text-jhz-navy-dark hover:bg-yellow-400 shadow-xs'
                : 'border border-jhz-navy/20 text-jhz-navy hover:bg-jhz-navy hover:text-white',
            ]}
          >
            {action.label}
          </a>
        ))}
      </div>

      <!-- ÚNICO Botón Hamburguesa (Móvil y Tablet) -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="xl:hidden inline-flex items-center justify-center p-2.5 rounded-xl text-jhz-navy hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-jhz-navy transition-colors"
      >
        <svg id="icon-menu-open" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="hidden w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Cajón Móvil Unificado -->
  <div id="mobile-drawer" class="hidden xl:hidden bg-white border-t border-slate-200 max-h-[calc(100vh-5rem)] overflow-y-auto shadow-2xl">
    <div class="px-4 py-5 space-y-4">
      <!-- Acciones rápidas destacadas arriba en móvil -->
      <div class="grid grid-cols-2 gap-2.5 pb-3 border-b border-slate-100">
        {QUICK_ACTIONS.map((action) => (
          <a
            href={action.href}
            target={action.external ? '_blank' : undefined}
            rel={action.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'text-center py-2.5 px-3 rounded-xl text-sm font-bold transition-colors',
              action.highlight
                ? 'bg-jhz-gold text-jhz-navy-dark'
                : 'bg-jhz-navy text-white',
            ]}
          >
            {action.label}
          </a>
        ))}
      </div>

      <!-- Lista de enlaces con acordeones nativos <details> (0 JS extra) -->
      <nav aria-label="Menú móvil" class="space-y-1">
        {MAIN_NAV.map((item) =>
          item.children ? (
            <details class="group rounded-xl">
              <summary class="flex items-center justify-between px-3 py-2.5 text-base font-semibold text-slate-800 hover:bg-slate-50 rounded-xl cursor-pointer list-none">
                <span>{item.label}</span>
                <svg class="w-5 h-5 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <ul class="pl-4 pr-2 py-1.5 space-y-1 border-l-2 border-jhz-gold ml-3 mt-1">
                {item.children.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      target={sub.external ? '_blank' : undefined}
                      rel={sub.external ? 'noopener noreferrer' : undefined}
                      class="block py-2 px-3 rounded-lg text-sm font-medium text-slate-600 hover:text-jhz-navy hover:bg-slate-50"
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              href={item.href}
              class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-slate-50"
            >
              {item.label}
            </a>
          )
        )}
      </nav>

      <!-- Contacto y redes en móvil -->
      <div class="pt-4 border-t border-slate-100 text-xs text-slate-500 space-y-2">
        <p>{SITE_INFO.address}</p>
        <div class="flex items-center gap-4 font-semibold text-jhz-navy">
          <a href={SITE_INFO.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={SITE_INFO.socials.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href={SITE_INFO.socials.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    drawer?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>