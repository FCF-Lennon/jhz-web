---
import MainLayout from '../layouts/MainLayout.astro';
import Hero  from '../components/Hero.astro';
---

<MainLayout title="Colegio JHZ – Vista previa de navegación">
  <Hero />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="p-8 rounded-2xl bg-jhz-surface border border-slate-200 text-center">
      <h1 class="text-2xl font-bold text-jhz-navy">
        Prueba de Navbar y Footer JHZ
      </h1>
      <p class="text-slate-600 mt-2">
        Prueba achicar la ventana a tamaño teléfono para verificar el menú hamburguesa único.
      </p>
    </div>
  </section>
</MainLayout>